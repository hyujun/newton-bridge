# Copy to .env and edit to override defaults (docker compose auto-loads .env).
#
# Simulator session settings (sync_mode, viewer, status_log_hz, …) live in
# `config/config.yaml`. Precedence: CLI flag > env var > config.yaml > default.
# Uncomment a line here only when you want a one-shot env override; an empty
# or missing entry lets the yaml value take effect.

# -- Display (GUI viewer) -----------------------------------------------------
DISPLAY=:0

# -- GPU selection ------------------------------------------------------------
# Use "0", "0,1", or "all" to pick which NVIDIA devices the container sees.
NVIDIA_VISIBLE_DEVICES=all

# -- ROS 2 DDS (env-only — not in config.yaml) --------------------------------
# Must match the host ROS 2 environment, otherwise discovery silently drops.
ROS_DOMAIN_ID=0
# Default: Cyclone DDS. Set to rmw_fastrtps_cpp to opt into FastDDS — in that
# case run.sh will also export FASTDDS_BUILTIN_TRANSPORTS=UDPv4 (required so
# the SHM transport doesn't break at the container/host UID boundary).
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# -- newton_bridge pack (env-only) --------------------------------------------
# Robot pack directory (container path). Matches ROBOT=<name> in run.sh.
ROBOT_PACK=/workspace/robots/ur5e

# -- Session overrides (yaml in config/config.yaml; uncomment to override) ----
# SYNC_MODE=sync                    # yaml: sim.sync_mode (freerun | sync)
# FREERUN_RATE=max                  # yaml: sim.freerun_rate (realtime | max)
# VIEWER=rerun                      # yaml: viewer.mode (gl|rerun|usd|file|null|none)
# VIEWER_WIDTH=1920                 # yaml: viewer.width
# VIEWER_HEIGHT=1080                # yaml: viewer.height
# STATUS_LOG_HZ=1.0                 # yaml: sim.status_log_hz (0 = off)
# LOG_LEVEL=DEBUG                   # yaml: logging.level
# RERUN_WEB_PORT=9091               # yaml: viewer.rerun.web_port (on port conflict)
# RERUN_GRPC_PORT=9877              # yaml: viewer.rerun.grpc_port (match Connection URL)
# RERUN_RECORD_TO=/workspace/workspace/runs/session.rrd

# -- Jupyter ------------------------------------------------------------------
JUPYTER_TOKEN=newton